<div
  class="custom-promo-bar spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="custom-promo-bar__container">
    <span class="custom-promo-bar__text">
      {{ section.settings.consultant_text }}
    </span>
    {% if section.settings.link_text != blank %}
      <a
        href="{{ section.settings.link_url | default: '#' }}"
        class="custom-promo-bar__link"
      >
        {{ section.settings.link_text }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
/* Figma: "Section" (1536x35) fill:#141414 pad:0/64/0/64 */
.custom-promo-bar {
  background-color: #141414;
  padding-block: calc(0px + var(--padding-block-start, 0px)) calc(0px + var(--padding-block-end, 0px));
  padding-inline: 64px;

  /* Figma: "Container" (1408x35) [HORIZONTAL, justify:space-between, align:center] */
  .custom-promo-bar__container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 35px;
  }

  /* Figma: inner "Container" (237x30) pad:5/5/5/0 → TEXT (232x20) DM Sans 400 14px/20px #FFFFFF */
  .custom-promo-bar__text {
    font: 400 14px/20px var(--font-body--family);
    color: #FFFFFF;
    padding-block: 5px;
  }

  /* Figma: inner "Container" (204x16) → TEXT "Link" (199x14) DM Sans 400 14px/14px UNDERLINE #FFFFFF */
  .custom-promo-bar__link {
    font: 400 14px/14px var(--font-body--family);
    color: #FFFFFF;
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    /* Figma: "Promo bar" (390x32) pad:8/12/8/12 gap:16px */
    padding-block: calc(8px + var(--padding-block-start, 0px)) calc(8px + var(--padding-block-end, 0px));
    padding-inline: 12px;

    .custom-promo-bar__container {
      gap: 16px;
      min-height: auto;
    }

    /* Figma: TEXT (197x16) DM Sans 400 12px/16px #FFFFFF */
    .custom-promo-bar__text {
      font-size: 12px;
      line-height: 16px;
      padding-block: 0;
    }

    .custom-promo-bar__link {
      display: none;
    }
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Promo bar",
  "tag": "section",
  "class": "custom-promo-bar-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "consultant_text",
      "label": "Consultant text",
      "default": "Your Shop Consultant is SHOP.COM"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Start Your SHOP.COM Business"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Promo bar",
      "category": "Banners"
    }
  ]
}
{% endschema %}
