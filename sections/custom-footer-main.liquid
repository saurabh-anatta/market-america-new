{% liquid
  assign section_width = section.settings.section_width
  assign email_heading = section.settings.email_heading
  assign email_placeholder = section.settings.email_placeholder
  assign email_button_text = section.settings.email_button_text
  assign terms_url = section.settings.terms_url
  assign privacy_url = section.settings.privacy_url
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="custom-footer-main">
    {%- comment -%} Language/Country selector {%- endcomment -%}
    <div class="custom-footer-main__selector">
      <div class="custom-footer-main__pill">
        <span class="custom-footer-main__pill-text">{{ localization.language.iso_code | upcase }}</span>
        <img
          src="{{ 'chevron-forward-streamline-outlined-material-symbols-3.svg' | asset_url }}"
          alt=""
          width="15"
          height="9"
          class="custom-footer-main__pill-chevron"
        >
      </div>
      <div class="custom-footer-main__pill custom-footer-main__pill--country">
        <span class="custom-footer-main__pill-country-inner">
          <img
            src="{{ 'us-united-states-streamline-flagpack.svg' | asset_url }}"
            alt=""
            width="18"
            height="18"
            class="custom-footer-main__pill-flag"
          >
          <span class="custom-footer-main__pill-text">{{ localization.country.name }}</span>
        </span>
        <img
          src="{{ 'chevron-forward-streamline-outlined-material-symbols-3.svg' | asset_url }}"
          alt=""
          width="15"
          height="9"
          class="custom-footer-main__pill-chevron"
        >
      </div>
    </div>

    {%- comment -%} Email signup {%- endcomment -%}
    <div class="custom-footer-main__signup">
      {% if email_heading != blank %}
        <p class="custom-footer-main__signup-heading">{{ email_heading | escape }}</p>
      {% endif %}

      <div class="custom-footer-main__signup-form-wrapper">
        {%- form 'customer', class: 'custom-footer-main__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="custom-footer-main__signup-input-group">
            <input
              type="email"
              name="contact[email]"
              class="custom-footer-main__signup-input"
              placeholder="{{ email_placeholder | default: 'Email address' | escape }}"
              required
              autocomplete="email"
              aria-label="{{ email_placeholder | default: 'Email address' | escape }}"
            >
            <button type="submit" class="custom-footer-main__signup-button">
              {{ email_button_text | default: 'Subscribe' | escape }}
            </button>
          </div>
        {%- endform -%}

        <div class="custom-footer-main__disclaimer">
          <span>By signing up you agree to our</span>
          {% if terms_url != blank %}
            <a href="{{ terms_url }}" class="custom-footer-main__disclaimer-link">Terms of Use</a>
          {% else %}
            <span class="custom-footer-main__disclaimer-link">Terms of Use</span>
          {% endif %}
          <span>&amp;</span>
          {% if privacy_url != blank %}
            <a href="{{ privacy_url }}" class="custom-footer-main__disclaimer-link">Privacy Policy</a>
          {% else %}
            <span class="custom-footer-main__disclaimer-link">Privacy Policy</span>
          {% endif %}
        </div>
      </div>
    </div>

    {%- comment -%} Navigation menus {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <nav class="custom-footer-main__nav" aria-label="Footer navigation">
        {% for block in section.blocks %}
          {% if block.type == 'menu-column' %}
            <details class="custom-footer-main__menu-group" {{ block.shopify_attributes }}>
              <summary class="custom-footer-main__menu-heading">
                <span>{{ block.settings.heading | escape }}</span>
                <img
                  src="{{ 'chevron-forward-streamline-outlined-material-symbols-3.svg' | asset_url }}"
                  alt=""
                  width="15"
                  height="9"
                  class="custom-footer-main__menu-chevron"
                >
              </summary>
              {% if block.settings.menu != blank %}
                <ul class="custom-footer-main__menu-list">
                  {% for link in block.settings.menu.links %}
                    <li>
                      <a href="{{ link.url }}" class="custom-footer-main__menu-link">
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </details>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    {%- comment -%} Social media icons {%- endcomment -%}
    <div class="custom-footer-main__social">
      {% if section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="custom-footer-main__social-link">
          <img src="{{ 'social-icons.svg' | asset_url }}" alt="Facebook" width="24" height="24">
        </a>
      {% endif %}
      {% if section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="custom-footer-main__social-link">
          <img src="{{ 'social-icons-2.svg' | asset_url }}" alt="Instagram" width="24" height="24">
        </a>
      {% endif %}
      {% if section.settings.tiktok_url != blank %}
        <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="custom-footer-main__social-link">
          <img src="{{ 'social-icons-3.svg' | asset_url }}" alt="TikTok" width="24" height="24">
        </a>
      {% endif %}
      {% if section.settings.twitter_url != blank %}
        <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="custom-footer-main__social-link">
          <img src="{{ 'social-icons-4.svg' | asset_url }}" alt="X (Twitter)" width="24" height="24">
        </a>
      {% endif %}
      {% if section.settings.youtube_url != blank %}
        <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="custom-footer-main__social-link">
          <img src="{{ 'social-icons-5.svg' | asset_url }}" alt="YouTube" width="24" height="24">
        </a>
      {% endif %}
    </div>

    {%- comment -%} Bottom area: Logo + Payment cards {%- endcomment -%}
    <div class="custom-footer-main__bottom">
      <div class="custom-footer-main__logo">
        <img
          src="{{ 'shop-logo-all-white-1.svg' | asset_url }}"
          alt="{{ shop.name }}"
          width="356"
          height="48"
          class="custom-footer-main__logo-image"
          loading="lazy"
        >
      </div>

      <div class="custom-footer-main__payments">
        <img src="{{ 'img.svg' | asset_url }}" alt="Visa" width="44" height="28" loading="lazy">
        <img src="{{ 'img-2.svg' | asset_url }}" alt="Mastercard" width="44" height="28" loading="lazy">
        <img src="{{ 'img-3.svg' | asset_url }}" alt="American Express" width="44" height="28" loading="lazy">
        <img src="{{ 'img-4.svg' | asset_url }}" alt="PayPal" width="44" height="28" loading="lazy">
        <img src="{{ 'img-5.svg' | asset_url }}" alt="Discover" width="44" height="28" loading="lazy">
        <img src="{{ 'img-6.svg' | asset_url }}" alt="Other" width="44" height="28" loading="lazy">
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.custom-footer-main {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* ===== Language/Country selector pills ===== */
.custom-footer-main__selector {
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: center;
}

.custom-footer-main__pill {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 4px 8px 4px 12px;
  background-color: #EEEEEE;
  border-radius: 20px;
}

.custom-footer-main__pill-text {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: var(--font-size--xs);
  line-height: 16px;
  color: #141414;
}

.custom-footer-main__pill-country-inner {
  display: flex;
  align-items: center;
  gap: 4px;
}

.custom-footer-main__pill-flag {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  object-fit: cover;
}

.custom-footer-main__pill-chevron {
  width: 15px;
  height: 9px;
  transform: rotate(90deg);
}

/* ===== Email signup ===== */
.custom-footer-main__signup {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.custom-footer-main__signup-heading {
  font-family: var(--font-body--family);
  font-weight: 600;
  font-size: var(--font-size--base);
  line-height: 24px;
  color: var(--color-foreground);
  margin: 0;
}

.custom-footer-main__newsletter-form {
  margin: 0;
}

.custom-footer-main__signup-form-wrapper {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.custom-footer-main__signup-input-group {
  display: flex;
  flex-direction: row;
}

.custom-footer-main__signup-input {
  flex: 1;
  min-width: 0;
  padding: 12px 24px;
  border: none;
  border-radius: 40px 0 0 40px;
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: var(--font-size--base);
  line-height: 24px;
  color: #141414;
  background-color: #FFFFFF;
  outline: none;
}

.custom-footer-main__signup-input::placeholder {
  color: #ACACAC;
}

.custom-footer-main__signup-button {
  padding: 12px 24px;
  border: none;
  border-radius: 0 40px 40px 0;
  background-color: var(--color-primary);
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: var(--font-size--base);
  line-height: 24px;
  color: #FFFFFF;
  cursor: pointer;
  white-space: nowrap;
}

.custom-footer-main__signup-button:hover {
  background-color: var(--color-primary-hover);
}

/* ===== Disclaimer ===== */
.custom-footer-main__disclaimer {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: var(--font-size--xs);
  line-height: 16px;
  color: var(--color-foreground);
}

.custom-footer-main__disclaimer-link {
  color: var(--color-foreground);
  text-decoration: underline;
}

/* ===== Navigation menus ===== */
.custom-footer-main__nav {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 16px 0;
}

.custom-footer-main__menu-group {
  padding-bottom: 20px;
  border-bottom: 1px solid #C9C9C9;
}

.custom-footer-main__menu-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-inline-end: 16px;
  cursor: pointer;
  list-style: none;
}

.custom-footer-main__menu-heading::-webkit-details-marker {
  display: none;
}

.custom-footer-main__menu-heading span {
  font-family: var(--font-body--family);
  font-weight: 600;
  font-size: var(--font-size--sm);
  line-height: 14px;
  letter-spacing: 0.56px;
  text-transform: uppercase;
  color: var(--color-foreground);
}

.custom-footer-main__menu-chevron {
  width: 15px;
  height: 9px;
  transition: transform 0.3s ease;
}

.custom-footer-main__menu-group[open] .custom-footer-main__menu-chevron {
  transform: rotate(180deg);
}

.custom-footer-main__menu-list {
  list-style: none;
  padding: 0;
  margin: 20px 0 0 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.custom-footer-main__menu-link {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: var(--font-size--sm);
  line-height: 20px;
  color: var(--color-foreground);
  text-decoration: none;
}

.custom-footer-main__menu-link:hover {
  text-decoration: underline;
}

/* ===== Social media icons ===== */
.custom-footer-main__social {
  display: flex;
  flex-direction: row;
  gap: 24px;
  align-items: center;
}

.custom-footer-main__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-footer-main__social-link img {
  width: 24px;
  height: 24px;
}

/* ===== Bottom area: Logo + Payment cards ===== */
.custom-footer-main__bottom {
  display: flex;
  flex-direction: column;
  gap: 40px;
  align-items: center;
  padding: 32px 0;
}

.custom-footer-main__logo {
  display: flex;
  justify-content: center;
}

.custom-footer-main__logo-image {
  max-width: 356px;
  width: 100%;
  height: auto;
}

.custom-footer-main__payments {
  display: flex;
  flex-direction: row;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}

.custom-footer-main__payments img {
  width: 44px;
  height: 28px;
}

/* ===== Desktop layout ===== */
@media screen and (min-width: 750px) {
  .custom-footer-main__signup {
    max-width: 500px;
  }

  .custom-footer-main__nav {
    flex-direction: row;
    gap: 32px;
    padding: 16px 0;
  }

  .custom-footer-main__menu-group {
    flex: 1;
    border-bottom: none;
    padding-bottom: 0;
  }

  .custom-footer-main__menu-heading {
    pointer-events: none;
    cursor: default;
  }

  .custom-footer-main__menu-chevron {
    display: none;
  }

  /* Force details content visible on desktop — overrides UA hidden state */
  .custom-footer-main__menu-group > .custom-footer-main__menu-list {
    display: flex;
  }

  .custom-footer-main__menu-list {
    margin-top: 20px;
  }
}

@media screen and (max-width: 749px) {
  .custom-footer-main__signup {
    width: 100%;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_footer_main",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:content.email_signup"
    },
    {
      "type": "text",
      "id": "email_heading",
      "label": "t:settings.email_heading",
      "default": "Sign up for new product launches, priority access and updates"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:settings.email_placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_button_text",
      "label": "t:settings.email_button_text",
      "default": "Subscribe"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "t:settings.terms_url"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "t:settings.privacy_url"
    },
    {
      "type": "header",
      "content": "t:content.social_media"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "t:options.facebook"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:options.instagram"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "t:options.tiktok"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "t:options.twitter"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "t:options.youtube"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "menu-column",
      "name": "t:names.custom_footer_main_menu_column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:settings.menu"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:names.custom_footer_main",
      "category": "t:categories.footer",
      "blocks": [
        {
          "type": "menu-column",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "menu-column",
          "settings": {
            "heading": "Features"
          }
        },
        {
          "type": "menu-column",
          "settings": {
            "heading": "Learn"
          }
        },
        {
          "type": "menu-column",
          "settings": {
            "heading": "Support"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
