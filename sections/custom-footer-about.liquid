{% liquid
  assign section_width = section.settings.section_width
  assign image = section.settings.image
  assign label = section.settings.label
  assign description = section.settings.description
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="custom-footer-about">
    {% if image != blank %}
      <div class="custom-footer-about__image-wrapper">
        {{
          image
          | image_url: width: image.width
          | image_tag:
            sizes: '100vw',
            widths: '375,550,750,1100,1500',
            loading: 'lazy',
            class: 'custom-footer-about__image',
            alt: image.alt
        }}
      </div>
    {% endif %}

    <div
      class="custom-footer-about__content"
      style="--about-bg: {{ bg_color }}; --about-text: {{ text_color }};"
    >
      {% if label != blank %}
        <p class="custom-footer-about__label">{{ label | escape }}</p>
      {% endif %}

      {% if description != blank %}
        <p class="custom-footer-about__description">{{ description | escape }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
.custom-footer-about {
  display: flex;
  flex-direction: column;
}

.custom-footer-about__image-wrapper {
  width: 100%;
  overflow: hidden;
}

.custom-footer-about__image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.custom-footer-about__content {
  background-color: var(--about-bg, #DEF6FF);
  color: var(--about-text, #141414);
  padding: 40px 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  justify-content: center;
}

.custom-footer-about__label {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: var(--font-size--xs);
  line-height: 20px;
  text-transform: uppercase;
  margin: 0;
}

.custom-footer-about__description {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 24px;
  margin: 0;
}

@media screen and (min-width: 750px) {
  .custom-footer-about__content {
    padding: 48px 40px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_footer_about",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "About SHOP.COM"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description",
      "default": "Market America | SHOP.COM is a product brokerage and internet marketing company powered by entrepreneurs around the world."
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#DEF6FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#141414"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
