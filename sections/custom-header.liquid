{% liquid
  assign search_placeholder = section.settings.search_placeholder | default: 'Search products'
  assign quiz_text = section.settings.quiz_button_text | default: 'Take Quiz'
  assign signin_text = section.settings.signin_text | default: 'Sign in'
  assign cart_text = section.settings.cart_text | default: 'Cart'
  assign marketing_msg = section.settings.marketing_message
  assign cta_text = section.settings.cta_text | default: 'Get Paid Daily.'
%}

<custom-header-section
  class="custom-header{% if section.settings.enable_sticky %} custom-header--sticky{% endif %}"
  id="custom-header-{{ section.id }}"
>
  {%- comment -%} ===== TOP ROW (Row 1) ===== {%- endcomment -%}
  <div class="custom-header__row custom-header__row--top color-{{ section.settings.color_scheme }}">
    <div class="custom-header__row-inner custom-header__row-inner--top">
      {%- comment -%} Left: Logo {%- endcomment -%}
      <div class="custom-header__left">
        <a href="{{ routes.root_url }}" class="custom-header__logo-link" aria-label="{{ shop.name }}">
          <img
            src="{{ 'shop-logo.svg' | asset_url }}"
            alt="{{ shop.name }}"
            class="custom-header__logo custom-header__logo--desktop"
            width="178"
            height="24"
            loading="eager"
          >
          <img
            src="{{ 'shop-logo-2.svg' | asset_url }}"
            alt="{{ shop.name }}"
            class="custom-header__logo custom-header__logo--mobile"
            width="148"
            height="20"
            loading="eager"
          >
        </a>
      </div>

      {%- comment -%} Mobile left: hamburger + logo {%- endcomment -%}
      <div class="custom-header__mobile-left">
        <button
          type="button"
          class="custom-header__hamburger"
          aria-label="{{ 'accessibility.menu' | t }}"
          aria-expanded="false"
          data-drawer-open
        >
          <img
            src="{{ 'menu-streamline-sharp-material-symbols.svg' | asset_url }}"
            alt=""
            width="28"
            height="28"
            aria-hidden="true"
          >
        </button>
        <a href="{{ routes.root_url }}" class="custom-header__logo-link" aria-label="{{ shop.name }}">
          <img
            src="{{ 'shop-logo-2.svg' | asset_url }}"
            alt="{{ shop.name }}"
            class="custom-header__logo"
            width="148"
            height="20"
            loading="eager"
          >
        </a>
      </div>

      {%- comment -%} Center: Search {%- endcomment -%}
      <div class="custom-header__center">
        <form action="{{ routes.search_url }}" method="get" class="custom-header__search-form" role="search">
          <input
            type="search"
            name="q"
            class="custom-header__search-input"
            placeholder="{{ search_placeholder | escape }}"
            aria-label="{{ search_placeholder | escape }}"
            autocomplete="off"
          >
          <button type="submit" class="custom-header__search-btn" aria-label="Search">
            <img
              src="{{ 'search-streamline-sharp-streamline-material-free.svg' | asset_url }}"
              alt=""
              width="20"
              height="20"
              aria-hidden="true"
            >
          </button>
        </form>
      </div>

      {%- comment -%} Right: Actions (desktop) {%- endcomment -%}
      <div class="custom-header__right">
        {%- if section.settings.quiz_button_url != blank -%}
          <a href="{{ section.settings.quiz_button_url }}" class="custom-header__quiz-btn">
            {{- quiz_text | escape -}}
          </a>
        {%- else -%}
          <span class="custom-header__quiz-btn">{{ quiz_text | escape }}</span>
        {%- endif -%}

        <div class="custom-header__actions">
          <a href="#" class="custom-header__action-item custom-header__action-item--flag" aria-label="Country">
            <img
              src="{{ 'us-united-states-streamline-flagpack.svg' | asset_url }}"
              alt="US"
              width="18"
              height="18"
            >
          </a>

          <a href="{{ routes.account_url | default: routes.account_login_url }}" class="custom-header__action-item">
            <img
              src="{{ 'frame-663.svg' | asset_url }}"
              alt=""
              width="20"
              height="20"
              aria-hidden="true"
              class="custom-header__action-icon"
            >
            <span class="custom-header__action-text">{{ signin_text | escape }}</span>
          </a>

          <a href="{{ routes.cart_url }}" class="custom-header__action-item">
            <img
              src="{{ 'shopping-bag-streamline-outlined-material-symbols.svg' | asset_url }}"
              alt=""
              width="28"
              height="28"
              aria-hidden="true"
              class="custom-header__action-icon"
            >
            <span class="custom-header__action-text">{{ cart_text | escape }}</span>
          </a>
        </div>
      </div>

      {%- comment -%} Mobile right: sign-in + cart icons only {%- endcomment -%}
      <div class="custom-header__mobile-right">
        <a href="{{ routes.account_url | default: routes.account_login_url }}" class="custom-header__mobile-action" aria-label="{{ signin_text | escape }}">
          <img
            src="{{ 'frame-663.svg' | asset_url }}"
            alt=""
            width="20"
            height="20"
            aria-hidden="true"
          >
        </a>
        <a href="{{ routes.cart_url }}" class="custom-header__mobile-action" aria-label="{{ cart_text | escape }}">
          <img
            src="{{ 'shopping-bag-streamline-outlined-material-symbols.svg' | asset_url }}"
            alt=""
            width="28"
            height="28"
            aria-hidden="true"
          >
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} ===== MOBILE SEARCH ROW (Row 2 mobile) ===== {%- endcomment -%}
  <div class="custom-header__row custom-header__row--mobile-search color-{{ section.settings.color_scheme }}">
    <div class="custom-header__row-inner custom-header__row-inner--mobile-search">
      <form action="{{ routes.search_url }}" method="get" class="custom-header__search-form custom-header__search-form--mobile" role="search">
        <input
          type="search"
          name="q"
          class="custom-header__search-input"
          placeholder="{{ search_placeholder | escape }}"
          aria-label="{{ search_placeholder | escape }}"
          autocomplete="off"
        >
        <button type="submit" class="custom-header__search-btn" aria-label="Search">
          <img
            src="{{ 'search-streamline-sharp-streamline-material-free.svg' | asset_url }}"
            alt=""
            width="20"
            height="20"
            aria-hidden="true"
          >
        </button>
      </form>
      {%- if section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="custom-header__mobile-gradient-icon" aria-label="{{ cta_text | escape }}">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="18" cy="18" r="18" fill="#141414"/>
            <defs>
              <linearGradient id="mobile-cta-grad" x1="9" y1="18" x2="27" y2="18" gradientUnits="userSpaceOnUse">
                <stop stop-color="#C9D855"/>
                <stop offset="0.49" stop-color="#69BA86"/>
                <stop offset="1" stop-color="#408DA1"/>
              </linearGradient>
            </defs>
            <circle cx="18" cy="18" r="9" fill="url(#mobile-cta-grad)"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ===== SUBHEADER ROW (Row 2 desktop) ===== {%- endcomment -%}
  <div class="custom-header__row custom-header__row--subheader color-{{ section.settings.color_scheme_subheader }}">
    <div class="custom-header__row-inner custom-header__row-inner--subheader">
      {%- comment -%} Left: hamburger + text links {%- endcomment -%}
      <div class="custom-header__subheader-left">
        <button
          type="button"
          class="custom-header__hamburger custom-header__hamburger--subheader"
          aria-label="{{ 'accessibility.menu' | t }}"
          aria-expanded="false"
          data-drawer-open
        >
          <img
            src="{{ 'menu-streamline-sharp-material-symbols.svg' | asset_url }}"
            alt=""
            width="28"
            height="28"
            aria-hidden="true"
          >
        </button>
        {%- if section.settings.subheader_menu != blank -%}
          <nav class="custom-header__subheader-nav" aria-label="Secondary navigation">
            <ul class="custom-header__subheader-links">
              {%- for link in linklists[section.settings.subheader_menu].links -%}
                <li class="custom-header__subheader-link-item">
                  <a href="{{ link.url }}" class="custom-header__subheader-link">
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>

      {%- comment -%} Center: marketing message {%- endcomment -%}
      <div class="custom-header__subheader-center">
        {%- if marketing_msg != blank -%}
          {%- if section.settings.marketing_message_url != blank -%}
            <a href="{{ section.settings.marketing_message_url }}" class="custom-header__marketing-msg">
              {{- marketing_msg | escape -}}
            </a>
          {%- else -%}
            <span class="custom-header__marketing-msg">{{ marketing_msg | escape }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- comment -%} Right: gradient CTA pill {%- endcomment -%}
      <div class="custom-header__subheader-right">
        {%- if cta_text != blank -%}
          {%- if section.settings.cta_url != blank -%}
            <a href="{{ section.settings.cta_url }}" class="custom-header__gradient-cta">
              <span class="custom-header__gradient-cta-text">{{ cta_text | escape }}</span>
              <img
                src="{{ 'frame-1.svg' | asset_url }}"
                alt=""
                width="108"
                height="12"
                aria-hidden="true"
                class="custom-header__gradient-cta-arrow"
              >
            </a>
          {%- else -%}
            <span class="custom-header__gradient-cta">
              <span class="custom-header__gradient-cta-text">{{ cta_text | escape }}</span>
              <img
                src="{{ 'frame-1.svg' | asset_url }}"
                alt=""
                width="108"
                height="12"
                aria-hidden="true"
                class="custom-header__gradient-cta-arrow"
              >
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===== DRAWER MENU ===== {%- endcomment -%}
  <dialog class="custom-header__drawer" aria-label="{{ 'accessibility.menu' | t }}">
    <div class="custom-header__drawer-inner">
      <div class="custom-header__drawer-header">
        <a href="{{ routes.root_url }}" class="custom-header__logo-link" aria-label="{{ shop.name }}">
          <img
            src="{{ 'shop-logo-2.svg' | asset_url }}"
            alt="{{ shop.name }}"
            width="148"
            height="20"
            loading="lazy"
          >
        </a>
        <button type="button" class="custom-header__drawer-close" aria-label="{{ 'accessibility.close_dialog' | t }}" data-drawer-close>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      <nav class="custom-header__drawer-nav" aria-label="Main navigation">
        {%- if section.settings.drawer_menu != blank -%}
          <ul class="custom-header__drawer-menu">
            {%- for link in linklists[section.settings.drawer_menu].links -%}
              <li class="custom-header__drawer-menu-item{% if link.links.size > 0 %} has-children{% endif %}">
                <a href="{{ link.url }}" class="custom-header__drawer-menu-link">
                  {{- link.title | escape -}}
                </a>
                {%- if link.links.size > 0 -%}
                  <button type="button" class="custom-header__drawer-submenu-toggle" aria-expanded="false" aria-label="Expand {{ link.title | escape }}">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <ul class="custom-header__drawer-submenu">
                    {%- for child_link in link.links -%}
                      <li class="custom-header__drawer-submenu-item">
                        <a href="{{ child_link.url }}" class="custom-header__drawer-submenu-link">
                          {{- child_link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
    </div>
  </dialog>
</custom-header-section>

<script>
  (function() {
    /* Header height calculation */
    function calcHeaderHeight() {
      const el = document.getElementById('custom-header-{{ section.id }}');
      if (!el) return;
      const height = el.offsetHeight;
      document.body.style.setProperty('--header-height', height + 'px');
      document.body.style.setProperty('--header-group-height', height + 'px');
    }
    calcHeaderHeight();
    window.addEventListener('resize', calcHeaderHeight);

    /* Drawer open/close */
    const section = document.getElementById('custom-header-{{ section.id }}');
    if (!section) return;
    const dialog = section.querySelector('.custom-header__drawer');
    const openBtns = section.querySelectorAll('[data-drawer-open]');
    const closeBtns = section.querySelectorAll('[data-drawer-close]');

    for (const btn of openBtns) {
      btn.addEventListener('click', function() {
        if (dialog) {
          dialog.showModal();
          document.body.style.overflow = 'hidden';
        }
      });
    }

    for (const btn of closeBtns) {
      btn.addEventListener('click', function() {
        if (dialog) {
          dialog.close();
          document.body.style.overflow = '';
        }
      });
    }

    if (dialog) {
      dialog.addEventListener('click', function(e) {
        if (e.target === dialog) {
          dialog.close();
          document.body.style.overflow = '';
        }
      });

      dialog.addEventListener('close', function() {
        document.body.style.overflow = '';
      });
    }

    /* Submenu toggles */
    const toggles = section.querySelectorAll('.custom-header__drawer-submenu-toggle');
    for (const toggle of toggles) {
      toggle.addEventListener('click', function() {
        const expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', String(!expanded));
        const submenu = this.nextElementSibling;
        if (submenu) {
          submenu.style.display = expanded ? 'none' : 'block';
        }
      });
    }
  })();
</script>

{% stylesheet %}
  /* ==========================================
     Custom Header — Base & Layout
     ========================================== */
  custom-header-section {
    display: block;
    width: 100%;
  }

  custom-header-section.custom-header--sticky {
    position: sticky;
    top: 0;
    z-index: 4;
  }

  .custom-header__row {
    width: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  /* ==========================================
     Top Row (Row 1) — Desktop
     ========================================== */
  .custom-header__row--top {
    border-bottom: 1px solid var(--color-border, #dfdfdf);
  }

  .custom-header__row-inner--top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 12px 64px;
    min-height: 64px;
  }

  /* Desktop left (logo) — hidden on mobile */
  .custom-header__left {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .custom-header__logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .custom-header__logo {
    display: block;
  }

  .custom-header__logo--mobile {
    display: none;
  }

  /* Mobile left (hamburger + logo) — hidden on desktop */
  .custom-header__mobile-left {
    display: none;
    align-items: center;
    gap: 12px;
  }

  /* ==========================================
     Search (Center)
     ========================================== */
  .custom-header__center {
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 534px;
    margin: 0 auto;
  }

  .custom-header__search-form {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    border-radius: 20px;
    border: 1px solid #C9C9C9;
    padding: 8px 16px;
    background: #ffffff;
  }

  .custom-header__search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 24px;
    color: var(--color-foreground);
  }

  .custom-header__search-input::placeholder {
    color: #ACACAC;
  }

  .custom-header__search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
  }

  /* ==========================================
     Right Actions — Desktop
     ========================================== */
  .custom-header__right {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-shrink: 0;
  }

  .custom-header__quiz-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    border: 1px solid #141414;
    padding: 8px 16px;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 20px;
    color: #141414;
    text-decoration: none;
    background: #ffffff;
    cursor: pointer;
    white-space: nowrap;
  }

  .custom-header__quiz-btn:hover {
    background: #f5f5f5;
  }

  .custom-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .custom-header__action-item {
    display: flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: #141414;
    white-space: nowrap;
  }

  .custom-header__action-icon {
    display: block;
    flex-shrink: 0;
  }

  .custom-header__action-text {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 20px;
    color: #141414;
  }

  .custom-header__action-item--flag {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-header__action-item--flag img {
    width: 18px;
    height: 18px;
  }

  /* Mobile right — hidden on desktop */
  .custom-header__mobile-right {
    display: none;
    align-items: center;
    gap: 12px;
  }

  .custom-header__mobile-action {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #141414;
  }

  /* ==========================================
     Mobile Search Row (Row 2 mobile)
     ========================================== */
  .custom-header__row--mobile-search {
    display: none;
  }

  .custom-header__row-inner--mobile-search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 16px 12px 16px;
  }

  .custom-header__search-form--mobile {
    flex: 1;
  }

  .custom-header__mobile-gradient-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  /* ==========================================
     Subheader Row (Row 2 desktop)
     ========================================== */
  .custom-header__row--subheader {
    background: var(--color-background);
  }

  .custom-header__row-inner--subheader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 64px;
    min-height: 40px;
    gap: 24px;
  }

  .custom-header__subheader-left {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }

  .custom-header__hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
  }

  .custom-header__subheader-nav {
    display: flex;
    align-items: center;
  }

  .custom-header__subheader-links {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-header__subheader-link {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 20px;
    color: var(--color-foreground);
    text-decoration: none;
    white-space: nowrap;
  }

  .custom-header__subheader-link:hover {
    text-decoration: underline;
  }

  /* Subheader center: marketing message */
  .custom-header__subheader-center {
    flex: 1;
    text-align: center;
    min-width: 0;
  }

  .custom-header__marketing-msg {
    font-family: 'Roboto', var(--font-body--family), sans-serif;
    font-size: 16px;
    line-height: 19px;
    letter-spacing: -0.16px;
    color: var(--color-foreground);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  a.custom-header__marketing-msg:hover {
    text-decoration: underline;
  }

  /* Subheader right: gradient CTA */
  .custom-header__subheader-right {
    flex-shrink: 0;
  }

  .custom-header__gradient-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 32px;
    padding: 8px 16px;
    background: linear-gradient(90deg, #C9D855 0%, #69BA86 49%, #408DA1 100%);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .custom-header__gradient-cta:hover {
    opacity: 0.9;
  }

  .custom-header__gradient-cta-text {
    font-family: 'Roboto', var(--font-body--family), sans-serif;
    font-size: 14px;
    line-height: 17px;
    letter-spacing: -0.14px;
    color: #141414;
  }

  .custom-header__gradient-cta-arrow {
    display: block;
    flex-shrink: 0;
  }

  /* ==========================================
     Drawer Menu
     ========================================== */
  .custom-header__drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 380px;
    height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: #ffffff;
    z-index: 100;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .custom-header__drawer[open] {
    transform: translateX(0);
  }

  .custom-header__drawer::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .custom-header__drawer-inner {
    padding: 24px;
  }

  .custom-header__drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .custom-header__drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: #141414;
  }

  .custom-header__drawer-close:hover {
    opacity: 0.7;
  }

  .custom-header__drawer-nav {
    display: block;
  }

  .custom-header__drawer-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-header__drawer-menu-item {
    border-bottom: 1px solid #eeeeee;
  }

  .custom-header__drawer-menu-item:last-child {
    border-bottom: none;
  }

  .custom-header__drawer-menu-link {
    display: block;
    padding: 14px 0;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 24px;
    color: #141414;
    text-decoration: none;
  }

  .custom-header__drawer-menu-link:hover {
    color: #098AA7;
  }

  .custom-header__drawer-menu-item.has-children {
    position: relative;
  }

  .custom-header__drawer-menu-item.has-children > .custom-header__drawer-menu-link {
    padding-inline-end: 40px;
  }

  .custom-header__drawer-submenu-toggle {
    position: absolute;
    top: 10px;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #141414;
    transition: transform 0.2s ease;
  }

  .custom-header__drawer-submenu-toggle[aria-expanded="true"] {
    transform: rotate(90deg);
  }

  .custom-header__drawer-submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0 0 8px 16px;
  }

  .custom-header__drawer-submenu-link {
    display: block;
    padding: 10px 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 20px;
    color: #555555;
    text-decoration: none;
  }

  .custom-header__drawer-submenu-link:hover {
    color: #098AA7;
  }

  /* ==========================================
     Desktop: hide hamburger in top row
     ========================================== */
  @media screen and (min-width: 750px) {
    .custom-header__hamburger--subheader {
      display: flex;
    }

    .custom-header__row--top .custom-header__hamburger {
      display: none;
    }
  }

  /* ==========================================
     Mobile Responsive (max-width: 749px)
     ========================================== */
  @media screen and (max-width: 749px) {
    .custom-header__row-inner--top {
      padding: 10px 16px;
      min-height: 48px;
    }

    /* Hide desktop-only elements */
    .custom-header__left {
      display: none;
    }

    .custom-header__center {
      display: none;
    }

    .custom-header__right {
      display: none;
    }

    /* Show mobile-only elements */
    .custom-header__mobile-left {
      display: flex;
    }

    .custom-header__mobile-right {
      display: flex;
    }

    /* Show mobile search row */
    .custom-header__row--mobile-search {
      display: block;
    }

    /* Hide subheader on mobile */
    .custom-header__row--subheader {
      display: none;
    }

    /* Drawer adjustments */
    .custom-header__drawer {
      max-width: 320px;
    }
  }

  /* ==========================================
     Accessibility
     ========================================== */
  @media (prefers-reduced-motion: reduce) {
    .custom-header__drawer {
      transition: none;
    }
  }

  .custom-header__hamburger:focus-visible,
  .custom-header__search-btn:focus-visible,
  .custom-header__quiz-btn:focus-visible,
  .custom-header__action-item:focus-visible,
  .custom-header__mobile-action:focus-visible,
  .custom-header__drawer-close:focus-visible,
  .custom-header__drawer-submenu-toggle:focus-visible {
    outline: 2px solid var(--color-primary, #207D94);
    outline-offset: 2px;
  }
{% endstylesheet %}

