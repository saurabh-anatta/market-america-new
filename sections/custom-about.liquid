<section
  class="custom-about spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="custom-about__media">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: section.settings.image.width
        | image_tag:
          sizes: '(min-width: 750px) 59vw, 100vw',
          widths: '375, 550, 750, 1100, 1500, 1804',
          loading: 'lazy',
          alt: section.settings.image.alt,
          class: 'custom-about__img'
      }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'custom-about__img custom-about__placeholder' }}
    {% endif %}
  </div>

  <div class="custom-about__content">
    {% if section.settings.eyebrow_text != blank %}
      <p class="custom-about__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
    {% endif %}
    {% if section.settings.heading_text != blank %}
      <h2 class="custom-about__heading">{{ section.settings.heading_text | escape }}</h2>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /* Figma "Frame 1000003536" 1536x601, fill #DEF6FF — full-bleed band,
     image flush to left/top/bottom edges, text column on the right */
  .custom-about.spacing-style {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding-block: calc(0px + var(--padding-block-start, 0px)) calc(0px + var(--padding-block-end, 0px));
    background-color: #def6ff;
  }

  /* Figma "Rectangle 3458" 902x601 — 902/1536 ≈ 58.7% of the band width */
  .custom-about__media {
    flex: 0 0 58.7%;
    min-width: 0;
  }

  .custom-about__img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 902 / 601;
    object-fit: cover;
  }

  /* Figma "Frame 1000003300" 506x236 — text starts at x≈966 (64px from
     image edge at x=902), vertically centered */
  .custom-about__content {
    display: flex;
    flex-direction: column;
    row-gap: 16px;
    max-width: 506px;
    min-width: 0;
    padding-inline: 64px 20px;
  }

  /* Figma "About SHOP.COM" — Inter 400 14px/20px UPPER (theme body font substitutes) */
  .custom-about__eyebrow {
    margin: 0;
    color: #141414;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    text-transform: uppercase;
  }

  /* Figma heading 459x200 — DM Sans 400 32px/40px (theme body font substitutes) */
  .custom-about__heading {
    margin: 0;
    color: #141414;
    font-family: var(--font-body--family);
    font-size: 32px;
    font-weight: 400;
    line-height: 40px;
  }

  @media screen and (max-width: 749px) {
    /* Stack: full-width image first, text below */
    .custom-about.spacing-style {
      flex-direction: column;
      align-items: stretch;
    }

    .custom-about__media {
      flex: 0 0 auto;
      width: 100%;
    }

    .custom-about__content {
      max-width: none;
      padding: 32px 20px;
    }

    .custom-about__heading {
      font-size: 24px;
      line-height: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About",
  "tag": "section",
  "class": "custom-about-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "About SHOP.COM"
    },
    {
      "type": "textarea",
      "id": "heading_text",
      "label": "Heading",
      "default": "Market America | SHOP.COM is a product brokerage and internet marketing company powered by entrepreneurs around the world."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "About",
      "category": "Banners"
    }
  ]
}
{% endschema %}
