{% liquid
  assign collection_list = section.settings.collection_list
  assign heading = section.settings.heading
  assign link_label = section.settings.link_label
  assign link_url = section.settings.link_url
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="custom-category-grid">
    <div class="custom-category-grid__header">
      {% if heading != blank %}
        <h2 class="custom-category-grid__heading">{{ heading | escape }}</h2>
      {% endif %}
      {% if link_label != blank and link_url != blank %}
        <a href="{{ link_url }}" class="custom-category-grid__link">{{ link_label | escape }}</a>
      {% endif %}
    </div>

    <div class="custom-category-grid__grid">
      {% if collection_list.count > 0 %}
        {% for collection in collection_list %}
          <a href="{{ collection.url }}" class="custom-category-grid__card">
            {% if collection.image != blank %}
              {{
                collection.image
                | image_url: width: collection.image.width
                | image_tag:
                  sizes: '(min-width: 750px) 25vw, 50vw',
                  widths: '173,216,334,500,700',
                  loading: 'lazy',
                  class: 'custom-category-grid__card-image',
                  alt: collection.image.alt
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'custom-category-grid__card-placeholder' }}
            {% endif %}
            <span class="custom-category-grid__card-title">{{ collection.title | escape }}</span>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="custom-category-grid__card custom-category-grid__card--placeholder">
            {{ 'collection-1' | placeholder_svg_tag: 'custom-category-grid__card-placeholder' }}
            <span class="custom-category-grid__card-title">Collection {{ i }}</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
.custom-category-grid {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.custom-category-grid__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.custom-category-grid__heading {
  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: 400;
  font-size: 36px;
  line-height: 40px;
  letter-spacing: 0;
  color: var(--color-foreground);
  margin: 0;
}

.custom-category-grid__link {
  font-family: var(--font-subheading--family);
  font-style: var(--font-subheading--style);
  font-weight: 500;
  font-size: 18px;
  line-height: 38px;
  color: #098AA7;
  text-decoration: underline;
  white-space: nowrap;
  text-transform: uppercase;
}

.custom-category-grid__link:hover {
  opacity: 0.8;
}

.custom-category-grid__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.custom-category-grid__card {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  aspect-ratio: 334 / 418;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  text-decoration: none;
}

.custom-category-grid__card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0) 50%);
  pointer-events: none;
}

.custom-category-grid__card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.custom-category-grid__card-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.custom-category-grid__card-title {
  position: relative;
  z-index: 1;
  color: #FFFFFF;
  font-family: var(--font-heading--family);
  font-style: var(--font-heading--style);
  font-weight: 400;
  font-size: 24px;
  line-height: 32px;
  text-align: center;
  padding: 16px;
}

@media screen and (max-width: 749px) {
  .custom-category-grid {
    gap: 16px;
  }

  .custom-category-grid__heading {
    font-size: 24px;
    line-height: 32px;
  }

  .custom-category-grid__link {
    font-size: 16px;
  }

  .custom-category-grid__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .custom-category-grid__card {
    aspect-ratio: 1 / 1;
  }

  .custom-category-grid__card-title {
    font-size: 16px;
    line-height: 20px;
    padding: 12px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_category_grid",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collection_list"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:settings.link_url"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_category_grid",
      "category": "t:categories.collections"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
