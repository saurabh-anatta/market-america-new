<div
  class="custom-category-grid spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %} --category-link-color: {{ section.settings.link_color }};"
>
  <div class="custom-category-grid__header">
    {% if section.settings.heading_text != blank %}
      <h2 class="custom-category-grid__heading">{{ section.settings.heading_text | escape }}</h2>
    {% endif %}
    {% if section.settings.shop_all_text != blank %}
      <a class="custom-category-grid__shop-all" href="{{ section.settings.shop_all_url }}">
        {{- section.settings.shop_all_text | escape -}}
      </a>
    {% endif %}
  </div>

  <div class="custom-category-grid__grid">
    {% for block in section.blocks %}
      {% liquid
        assign mobile_image = block.settings.image_mobile | default: block.settings.image
      %}
      <a
        class="custom-category-grid__card"
        {% if block.settings.link_url != blank %}
          href="{{ block.settings.link_url }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="custom-category-grid__media custom-category-grid__media--desktop">
          {% if block.settings.image %}
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                sizes: '(min-width: 750px) 25vw, 50vw',
                widths: '173, 334, 375, 550, 750',
                loading: 'lazy',
                alt: block.settings.image.alt,
                class: 'custom-category-grid__img'
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'custom-category-grid__img custom-category-grid__placeholder' }}
          {% endif %}
        </div>
        <div class="custom-category-grid__media custom-category-grid__media--mobile">
          {% if mobile_image %}
            {{
              mobile_image
              | image_url: width: mobile_image.width
              | image_tag:
                sizes: '50vw',
                widths: '173, 334, 375, 550',
                loading: 'lazy',
                alt: mobile_image.alt,
                class: 'custom-category-grid__img'
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'custom-category-grid__img custom-category-grid__placeholder' }}
          {% endif %}
        </div>
        {% if block.settings.title != blank %}
          <span class="custom-category-grid__title">{{ block.settings.title | escape }}</span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  /* Figma desktop frame 1536x618: pad 64px all sides, 32px gap header->grid */
  .custom-category-grid.spacing-style {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
    padding-block: calc(64px + var(--padding-block-start, 0px)) calc(64px + var(--padding-block-end, 0px));
    padding-inline: 64px;
  }

  /* Header row — Figma "Frame 22" (1408x40) */
  .custom-category-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .custom-category-grid__heading {
    margin: 0;
    color: #141414;
    font-family: var(--font-h1--family, var(--font-heading--family));
    font-size: 36px;
    font-weight: 400;
    line-height: 40px;
  }

  .custom-category-grid__shop-all {
    color: var(--category-link-color, #098aa7);
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 500;
    line-height: 38px;
    text-decoration: underline;
    white-space: nowrap;

    &:focus-visible {
      outline: 2px solid #141414;
      outline-offset: 2px;
    }
  }

  /* Card grid — Figma "Frame 18" (1408x418), 4 cards 334x418, 24px gap */
  .custom-category-grid__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
  }

  .custom-category-grid__card {
    position: relative;
    display: block;
    aspect-ratio: 334 / 418;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;

    &:focus-visible {
      outline: 2px solid #141414;
      outline-offset: 2px;
    }
  }

  .custom-category-grid__media {
    width: 100%;
    height: 100%;
  }

  .custom-category-grid__media--mobile {
    display: none;
  }

  .custom-category-grid__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-category-grid__title {
    position: absolute;
    inset-inline: 0;
    bottom: 24px;
    padding-inline: 12px;
    color: #ffffff;
    font-family: var(--font-h1--family, var(--font-heading--family));
    font-size: 24px;
    font-weight: 400;
    line-height: 32px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    /* Figma mobile frame 390x492: pad 40/16, 16px gap, 2x2 square grid */
    .custom-category-grid.spacing-style {
      gap: 16px;
      padding-block: calc(40px + var(--padding-block-start, 0px)) calc(40px + var(--padding-block-end, 0px));
      padding-inline: 16px;
    }

    .custom-category-grid__header {
      gap: 18px;
    }

    .custom-category-grid__heading {
      font-size: 24px;
      line-height: 32px;
    }

    .custom-category-grid__shop-all {
      font-size: 16px;
    }

    .custom-category-grid__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .custom-category-grid__card {
      aspect-ratio: 1 / 1;
    }

    .custom-category-grid__media--desktop {
      display: none;
    }

    .custom-category-grid__media--mobile {
      display: block;
    }

    .custom-category-grid__title {
      bottom: 14px;
      font-size: 16px;
      line-height: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category grid",
  "tag": "section",
  "class": "custom-category-grid-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "header",
      "content": "Shop All link"
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Link text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#098AA7"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image (optional)",
          "info": "Leave empty to reuse the desktop image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "category": "Banners",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Beauty & Skincare"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Health & Nutrition"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Jewelery"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Weight Management"
          }
        }
      ]
    }
  ]
}
{% endschema %}
