                }
              },
              "block_order": ["image_1", "heading_1", "text_1"]
            },
            "card_2": {
              "type": "_card",
              "name": "t:names.card",
              "blocks": {
                "image_2": {
                  "type": "image",
                  "name": "t:names.image"
                },
                "heading_2": {
