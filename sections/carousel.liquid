            "card_3": {
              "type": "_card",
              "name": "t:names.card",
              "blocks": {
                "image_3": {
                  "type": "image",
                  "name": "t:names.image"
                },
                "heading_3": {
                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "t:html_defaults.made_to_last",
