                  }
                },
                "text_3": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "t:html_defaults.pieces_better_with_time"
                  }
                }
              },
              "block_order": ["image_3", "heading_3", "text_3"]
            },
            "card_4": {
              "type": "_card",
              "name": "t:names.card",
              "blocks": {
                "image_4": {
                  "type": "image",
                  "name": "t:names.image"
                },
                "heading_4": {
                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "t:html_defaults.quality_you_can_feel",
                    "type_preset": "h5"
                  }
                },
                "text_4": {
                  "type": "text",
                  "name": "t:names.text",
